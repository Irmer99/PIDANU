# App
APP_NAME=PDM-AI-Bridge
APP_VERSION=0.1.0
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pdm_ai_bridge

# Sunbird AI
SUNBIRD_API_KEY=your_sunbird_api_key_here
SUNBIRD_BASE_URL=https://api.sunbird.ai

# AWS S3 (for document storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=pdm-ai-bridge-docs
AWS_REGION=eu-west-1

# JWT Auth
JWT_SECRET_KEY=change-this-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# NIRA API (mocked for MVP)
NIRA_API_URL=https://api.nira.go.ug
NIRA_API_KEY=nira_mock_key

# Admin
ADMIN_EMAIL=admin@pdm.go.ug
ADMIN_PASSWORD=change-this-password
