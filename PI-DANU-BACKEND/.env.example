# App
APP_NAME=PDM-AI-Bridge
APP_VERSION=0.1.0
DEBUG=true

# Supabase Database
# Get from: Supabase Dashboard > Settings > Database > Connection string > URI
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Sunbird AI
SUNBIRD_API_KEY=your_sunbird_api_key_here
SUNBIRD_BASE_URL=https://api.sunbird.ai

# Storage
USE_SUPABASE_STORAGE=true

# JWT Auth
JWT_SECRET_KEY=change-this-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# NIRA API (mocked for MVP)
NIRA_API_URL=https://api.nira.go.ug
NIRA_API_KEY=nira_mock_key

# Admin
ADMIN_EMAIL=admin@pdm.go.ug
ADMIN_PASSWORD=change-this-password
